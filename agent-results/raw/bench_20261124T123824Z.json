   "190": "seq_len = tl.load(seq_lens + pid_b)",
   "191": "prefix_len = tl.load(prefix_lens + pid_b)",
   "192": "if pid_q * num_q_loop >= q_block_len:",
   "193": "return",
   "194": "real_q_loop = min(num_q_loop, q_block_len - pid_q * num_q_loop)",
   "195": "bt_row = block_table_ptr + pid_b * stride_bt_b",
   "196": "off_n = tl.arange(0, BLOCK_SIZE_K)",
   "203": "pid_q_j = pid_q * num_q_loop + j",
   "204": "t_ptr_j = t_ptr + (q_block_start + pid_q_j) * stride_tn + pid_kh * stride_th",
   "206": "q_abs = prefix_len + pid_q_j * BLOCK_SIZE_Q",
   "207": "valid_blocks = (q_abs + BLOCK_SIZE_K) // BLOCK_SIZE_K",
   "208": "real_topk = tl.minimum(max_topk, valid_blocks)",
