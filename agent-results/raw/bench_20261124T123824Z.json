   "184": "pid_q = tl.program_id(0)",
   "185": "pid_kh = tl.program_id(1)",
   "186": "pid_b = tl.program_id(2)",
   "187": "q_start = tl.load(cu_seqlens_q + pid_b)",
   "188": "q_block_start = tl.load(cu_seqblocks_q + pid_b)",
