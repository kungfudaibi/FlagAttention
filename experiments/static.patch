+# PARALLAX-006 experiment: opt-in static launch for the exact measured dense
+# target shape.  It keeps the old forward / fused-DQR / grouped-DKV kernels but
+# replaces the autotune sweep with the per-dtype configurations that the
+# PARALLAX-005 raw autotune logs measured fastest.  Default off.
+_STATIC_D64_ENV = "PARALLAX_STATIC_D64"
+
+# (BS, num_warps, num_stages) measured on GCU 1 at B2/T256/H2/HQ8/D64/G4.
+# Source: PARALLAX-005 p005-base-{fp16,bf16}-cold.log plus the three baseline
+# steady rounds; tie-broken by the median over all four runs.
+_STATIC_D64_CONFIGS = {
+    torch.float16: {
+        "fwd": (128, 1, 2),
+        "dqr": (128, 1, 2),
+        "dkv": (64, 1, 1),
+    },
+    torch.bfloat16: {
+        "fwd": (128, 1, 2),
+        "dqr": (64, 1, 1),
+        "dkv": (64, 1, 2),
+    },
+}
+
+
+def _static_d64_enabled():
+    return os.environ.get(_STATIC_D64_ENV, "0").strip().lower() in ("1", "true", "yes")
+
+
+def _static_d64_config(q, B, T, H, HQ, K, cu_seqlens, window_size_left):
+    """Return measured tiles only for the exact opt-in target shape."""
+    if not _static_d64_enabled():
+        return None
+    if q.device.type != "gcu" or cu_seqlens is not None or window_size_left >= 0:
+        return None
+    if B != 2 or T != 256 or H != 2 or HQ != 8 or K != 64 or HQ // H != 4:
+        return None
+    return _STATIC_D64_CONFIGS.get(q.dtype)
+
